{
  "name": "citadel",
  "version": "0.3.0",
  "description": "Infinite canvas creative reference tool",
  "main": "out/main/index.js",
  "author": "Kieran Beckenkrager (https://github.com/kannibalk1w1)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "dev:demo": "vite --config vite.demo.config.ts",
    "preview": "electron-vite preview",
    "engine": "node scripts/fetchWhisperEngine.mjs",
    "package": "npm run engine && electron-vite build && electron-builder",
    "test": "vitest",
    "mutation": "node scripts/mutationSweep.mjs",
    "e2e": "npm run build && playwright test",
    "a11y": "npm run build && playwright test --grep @a11y",
    "analyze": "electron-vite build --mode analyze",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "gifler": "^0.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "konva": "^9.3.3",
    "mammoth": "1.12.1",
    "nanoid": "^5.0.7",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.10",
    "three": "^0.162.0",
    "use-image": "^1.1.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.42.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.1",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.67",
    "@types/react-dom": "^18.2.22",
    "@types/three": "^0.162.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "axe-core": "~4.13.0",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.2",
    "electron-vite": "^2.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.2.2",
    "vitest": "^1.4.0"
  },
  "build": {
    "appId": "com.citadel.app",
    "productName": "Citadel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "!dist-release/**",
      "!dist-ci/**",
      "!dist-packs/**",
      "!Citadel-browser-demo.zip",
      "!dist-demo/**",
      "!playwright-report/**",
      "!test-results/**",
      "!e2e/**",
      "!docs/**",
      "!scripts/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "citadel",
        "name": "Citadel Project",
        "description": "Citadel project file",
        "mimeType": "application/x-citadel"
      },
      {
        "ext": "citadelz",
        "name": "Citadel Archive",
        "description": "Citadel bundled archive",
        "mimeType": "application/x-citadelz"
      }
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/whisper",
        "to": "whisper",
        "filter": [
          "**/*",
          "!README.md",
          "!.engine-version",
          "!*.bin"
        ]
      }
    ],
    "copyright": "Copyright © 2026 Kieran Beckenkrager",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Graphics",
      "synopsis": "Infinite canvas for references, notes, code and ideas",
      "desktop": {
        "StartupWMClass": "Citadel",
        "MimeType": "application/x-citadel;application/x-citadelz;"
      }
    }
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "esbuild@0.21.5": true
  }
}
