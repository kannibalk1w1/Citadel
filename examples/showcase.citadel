          "tags": [
            "start",
            "basics"
          ],
          "meta": {
            "content": "Pick a tool\n\nV select, C connect, N note, T text, K link. The toolbar names them all, and every one is rebindable in Settings.",
            "color": "#1d2a35"
          }
        },
